{
  "name": "Z-Wave JS Server DEVELOPMENT",
  "version": "0.0.19",
  "slug": "zwave_js_server",
  "description": "Not for production purposes, use at your own risk. Will grab latest version from Zwave JS server directly from Github master. Options renamed in 0.0.19: re-save your configuration after updating.",
  "url": "https://github.com/zwave-js/zwave-js-server",
  "startup": "system",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "map": ["config:rw"],
  "boot": "auto",
  "options": {
    "zwave_js_server_branch_or_commit": "zwave-js/zwave-js-server#master",
    "zwave_js_branch_or_commit": "",
    "serial_port": "/dev/ttyACM0",
    "securityKeys": {
      "S2_Unauthenticated": "",
      "S2_Authenticated": "",
      "S2_AccessControl": "",
      "S0_Legacy": ""
    },
    "logConfig": {
      "enabled": true,
      "level": "debug",
      "forceConsole": true,
      "logToFile": false,
      "filename": "/config/.zwjs/zjws.log"
    },
    "storage": {
      "cacheDir": "/config/.zwjs"
    },
    "presets": [

    ]
  },
  "schema": {
    "zwave_js_server_branch_or_commit": "str",
    "zwave_js_branch_or_commit": "str",
    "serial_port": "str",
    "securityKeys": {
      "S2_Unauthenticated": "str",
      "S2_Authenticated": "str",
      "S2_AccessControl": "str",
      "S0_Legacy": "str"
    },
    "logConfig": {
      "enabled": "bool",
      "level": "list(trace|debug|info|notice|warning|error|fatal)",
      "forceConsole": "bool",
      "logToFile": "bool",
      "filename": "str"
    },
    "storage": {
      "cacheDir": "str"
    },
    "presets": [
      "str"
    ]
  },
  "ports": {
    "3000/tcp": 3000
  },
  "uart": true
}
